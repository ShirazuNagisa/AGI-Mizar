{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-shell",
  "description": "The handful of shell actions the kernel's page is allowed to call: update checks, the three process switches, quitting, and the tray page sizing itself to its rows.",
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "local": false,
  "windows": [
    "main",
    "tray-panel"
  ],
  "permissions": [
    "allow-app-update-check",
    "allow-app-update-state",
    "allow-app-update-install",
    "allow-shell-settings-get",
    "allow-shell-settings-set",
    "allow-shell-login-item",
    "allow-app-quit",
    "allow-tray-panel-resize",
    "allow-tray-panel-open-settings"
  ]
}
