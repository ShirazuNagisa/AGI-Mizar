{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGI Mizar",
  "version": "0.1.1",
  "identifier": "me.shirazu.agimizar",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Host DSH, Claude Code and Codex in one place",
    "longDescription": "AGI Mizar runs DSH, Claude Code and Codex on this computer and lets a paired phone watch and steer all three.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ShirazuNagisa/AGI-Mizar/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwRDhGNjYzMjE3RjIwNDEKUldSQklIOGhZL2JZSUxFN3V2b2l0V0QzdGVYS0FYM0llWWN6cVBUMlhYMUd0dDlhRzJDRnEybEMK"
    }
  }
}
