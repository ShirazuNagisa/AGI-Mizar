{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGI Mizar",
  "version": "0.1.0",
  "identifier": "me.shirazu.agimizar",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": ["icons/icon.png"],
    "shortDescription": "Host DSH, Claude Code and Codex in one place",
    "longDescription": "AGI Mizar runs DSH, Claude Code and Codex on this computer and lets a paired phone watch and steer all three.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
